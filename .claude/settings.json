{
  "permissions": {
    "allow": [
      "Bash(docker compose up *)",
      "Bash(docker compose start *)",
      "Bash(docker compose stop *)",
      "Bash(docker compose down *)",
      "Bash(docker compose ps *)",
      "Bash(./gradlew runAll *)",
      "Bash(./gradlew :rfr-auth:bootRun *)",
      "Bash(./gradlew :rfr-api:bootRun *)",
      "Bash(./gradlew e2e *)",
      "Bash(./gradlew :rfr-e2e:test *)",
      "Bash(./gradlew :rfr-e2e:e2e *)",
      "Bash(npm run dev *)",
      "Bash(npm --prefix rfr-gql-client run dev *)",
      "Bash(bash ports.sh)",
      "Bash(mv * *.bak)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push)",
      "Bash(git -C * push *)",
      "Bash(git -c * push)",
      "Bash(git -c * push *)",
      "Bash(git --git-dir=* push *)",
      "Bash(command git push)",
      "Bash(command git push *)",
      "Bash(git rm)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(rm)",
      "Bash(rm *)",
      "Bash(command rm)",
      "Bash(command rm *)",
      "Bash(/bin/rm)",
      "Bash(/bin/rm *)",
      "Bash(/usr/bin/rm)",
      "Bash(/usr/bin/rm *)",
      "Bash(unlink)",
      "Bash(unlink *)",
      "Bash(rmdir *)",
      "Bash(xargs rm *)",
      "Bash(find * -delete)",
      "Bash(find * -delete *)",
      "Bash(find * -exec rm *)",
      "Bash(find * -exec unlink *)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compile.sh",
            "timeout": 180,
            "statusMessage": "Compiling"
          }
        ]
      }
    ]
  }
}
